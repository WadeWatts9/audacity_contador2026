# ==========================================
# Configuración de Entorno para Audacity
# ==========================================

# Puerto y enlace de red
# Para acceso exclusivo en esta máquina: 127.0.0.1
# Para modo aula en red local (LAN): 0.0.0.0
BIND_ADDRESS=0.0.0.0
APP_PORT=3003

# Base de datos PostgreSQL interna (no exponer al host)
POSTGRES_DB=audacity_db
POSTGRES_USER=audacity_user
POSTGRES_PASSWORD=audacity_password_secure_2026

# Clave secreta para tokens de sesión JWT (cambiar en entornos críticos)
SECRET_KEY=audacity_secret_key_production_2026_montevideo_uruguay

# Zona horaria oficial del servidor
TIMEZONE=America/Montevideo
